# Database option A: provide one complete URL (recommended for Railway).
# Railway provides MYSQL_URL internally. For local access, copy Railway's
# MYSQL_PUBLIC_URL value here (or set MYSQL_PUBLIC_URL directly).
DATABASE_URL=mysql+pymysql://user:password@public-host:public-port/database

# Database option B: individual values (used if DATABASE_URL is not set).
DB_USER=root
DB_PASSWORD=#kamsika#2007
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kamsikala

SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Comma-separated browser origins. Include the exact Vercel URL.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Set false in production if you do not want to allow Vercel preview URLs.
CORS_ALLOW_VERCEL=true

# Railway supplies PORT automatically. This is only needed when running locally.
PORT=5000
FLASK_DEBUG=false
