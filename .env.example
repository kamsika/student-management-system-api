DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_NAME=uki-skill-swap-web-app
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
FLASK_DEBUG=1

# Comma-separated browser origins allowed to call this API (required for Vercel + Railway).
# Local + production + current preview. App also allows https://*.vercel.app when
# CORS_ALLOW_VERCEL=true (default).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://student-tracking-sys.vercel.app,https://client-aj4y25kce-kamsikas-projects.vercel.app
FRONTEND_URL=https://client-aj4y25kce-kamsikas-projects.vercel.app
CORS_ALLOW_VERCEL=true

# Default to Sri Lanka / IST (+05:30). Use Asia/Kolkata if you prefer the India zone name.
APP_TIMEZONE=Asia/Colombo

