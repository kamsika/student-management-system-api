DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_NAME=uki-skill-swap-web-app
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
FLASK_DEBUG=1

# Comma-separated browser origins allowed to call this API (required for Vercel + Railway).
# Local dev + production frontend:
CORS_ORIGINS=http://localhost:3000,https://student-tracking-sys.vercel.app

# Optional shortcut: add one frontend URL without editing CORS_ORIGINS above.
# FRONTEND_URL=https://student-tracking-sys.vercel.app

